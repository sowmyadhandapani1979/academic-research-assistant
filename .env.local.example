# Literature-Swim API URL
LITERATURE_SWIM_API_URL=http://localhost:3000/api/receive-article

# Semantic Scholar Graph API key (from https://www.semanticscholar.org/product/api/api-key)
S2_API_KEY=

# Optional: Semantic Scholar API timeout (ms)
SEMANTIC_SCHOLAR_TIMEOUT=10000

# Optional local Ollama model for readable PDF text (defaults: localhost + phi3:mini)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=phi3:mini
