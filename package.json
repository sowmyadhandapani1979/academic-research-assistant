{
  "name": "academic-research-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "NODE_OPTIONS=--experimental-sqlite tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && NODE_OPTIONS=--experimental-sqlite vitest run --config vitest.server.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.2",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  }
}
